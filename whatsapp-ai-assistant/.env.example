NODE_ENV=development
PORT=3000

# Meta WhatsApp Cloud API
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=v21.0

# Private allowlist. Use international format, for example +509XXXXXXXX.
APPROVED_PHONE_NUMBER=

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# OpenAI
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_OUTPUT_TOKENS=700

# PostgreSQL or Supabase Postgres connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_ai_assistant
PGSSL=false

# Proactive assistant
ENABLE_PROACTIVE_CHECKIN=false
PROACTIVE_CHECKIN_TIME=08:00

# WordPress portal integration
WORDPRESS_BASE_URL=https://ai.stshaiti.com
WORDPRESS_API_KEY_ID=wp_live_xxx
WORDPRESS_HMAC_SECRET=
WORDPRESS_WEBHOOK_SECRET=
WORDPRESS_HMAC_MAX_SKEW_SECONDS=300
ALLOWED_WORDPRESS_ORIGIN=https://ai.stshaiti.com
LINK_CODE_TTL_SECONDS=1800
