{
  "name": "whatsapp-ai-assistant",
  "version": "0.1.0",
  "description": "Private WhatsApp AI assistant using Meta WhatsApp Cloud API, OpenAI API, Express, and PostgreSQL.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "check": "find src -name '*.js' -print0 | xargs -0 -n1 node --check"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {}
}
